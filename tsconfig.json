{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "@foldkit/markdown/content", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "scripts/**/*", "alchemy.run.ts"]
}
