import shapes { Rectangle, Square, rectangleArea, squareArea }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.io.logger { Logger }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.io.logger_native { StdoutLogger }

pub effect fn main() -> ()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let logger = run Arc<StdoutLogger>.make(StdoutLogger.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let room = Rectangle { width: 4, height: 3 }
  let tile = Square { side: 2 }
  let total = rectangleArea(&room) + squareArea(&tile)

  run Effect.log("The areas add up to {}.\n", &.(total)) |> Effect.provideAmbient<Logger>(&logger)
}
