import shapes { Rectangle, Square, rectangleArea, squareArea }
import silk.core.effect { Effect }
import silk.text.format { Format }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }

pub effect fn main() -> ()
  ! WriterError {
  let mut stdout = StdoutWriter.make()
  let room = Rectangle { width: 4, height: 3 }
  let tile = Square { side: 2 }
  let total = rectangleArea(&room) + squareArea(&tile)

  run Format.format("The areas add up to {}.\n", &.(total))
    |> Effect.provideMut<Writer>(&mut stdout)
}
