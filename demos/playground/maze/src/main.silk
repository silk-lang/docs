//! Breadth-first search through a maze. The search reaches cells in rings of
//! equal distance from the mouse, so the first time it reaches the cheese, it
//! has found a shortest path. Each cell remembers the cell it came from, and
//! walking those back from the cheese draws the path.
import silk.core.effect { Effect }
import silk.io.logger { LogError, Logger }
import silk.io.logger_native { StdoutLogger }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.text.string { String }

const WIDTH: usize = 25

const HEIGHT: usize = 13

const CELLS: usize = 325

const START: usize = 0

const EXIT: usize = 324

// A cell with no cell before it.
const NONE: usize = 325

// What the search knows about a cell.
const UNSEEN: i32 = 0

const FRONTIER: i32 = 1

const REACHED: i32 = 2

const PATH: i32 = 3

// Clears the screen and moves the cursor to the top left, in a terminal and
// in the playground.
const CLEAR: string = "\u{1b}[2J\u{1b}[H"

const MAZE: [string; 13] = [
  "S......#...#.........#...",
  "######.#.#.#.#######...#.",
  ".......#.#.#.....#...#.#.",
  ".#######...#####.#.#####.",
  ".......#.#...#...#...#...",
  ".###.#.#.###.#.###.#.#.#.",
  ".....#.....#...#...#...#.",
  "#.##.#####.#####.#.#####.",
  ".......#.....#...#...#...",
  ".#.#.###.#.#.#.####..#.##",
  ".#.#.#...#.#...#.....#...",
  ".#.###.###.#############.",
  ".#.......#..............E",
]

fn isOpen(cell: usize) -> bool {
  return String.utf8Bytes(MAZE[cell / WIDTH])[cell % WIDTH] != b"#"[0]
}

effect fn draw(marks: &[i32]) -> ()
  ! LogError
  ? &mut Logger {
  let mut cell: usize = 0
  while cell < CELLS {
    if cell == START {
      run Effect.log("🐭", &())
    } else if cell == EXIT {
      run Effect.log("🧀", &())
    } else if !isOpen(cell) {
      run Effect.log("⬛", &())
    } else if marks[cell] == PATH {
      run Effect.log("🟩", &())
    } else if marks[cell] == FRONTIER {
      run Effect.log("🟨", &())
    } else if marks[cell] == REACHED {
      run Effect.log("🟦", &())
    } else {
      run Effect.log("⬜", &())
    }
    cell = cell + 1
    if cell % WIDTH == 0 {
      run Effect.log("\n", &())
    }
  }
}

effect fn solve() -> ()
  ! LogError
  ? &mut Logger | &mut MonotonicClock {
  let mut marks = [UNSEEN; CELLS]
  let mut cameFrom = [NONE; CELLS]
  let mut queue: [usize; CELLS] = [0; CELLS]
  let mut head: usize = 0
  let mut tail: usize = 1
  queue[0] = START
  cameFrom[START] = START
  marks[START] = FRONTIER

  // One frame per ring: the frontier in yellow, what it came from in blue.
  let mut ring = 0
  while head < tail && cameFrom[EXIT] == NONE {
    run Effect.log("{}Ring {}: {} cells reached\n\n", &(CLEAR, ring, tail))
    run draw(&marks)
    run Effect.sleep(60ms)
    let ringEnd = tail
    while head < ringEnd {
      let cell = queue[head]
      head = head + 1
      marks[cell] = REACHED

      // The neighbors above, below, left and right, when they are inside
      // the maze, open, and not reached yet.
      let mut neighbors = [NONE; 4]
      if cell >= WIDTH {
        neighbors[0] = cell - WIDTH
      }
      if cell + WIDTH < CELLS {
        neighbors[1] = cell + WIDTH
      }
      if cell % WIDTH > 0 {
        neighbors[2] = cell - 1
      }
      if cell % WIDTH + 1 < WIDTH {
        neighbors[3] = cell + 1
      }
      let mut index: usize = 0
      while index < 4 {
        let next = neighbors[index]
        if next != NONE && isOpen(next) && cameFrom[next] == NONE {
          cameFrom[next] = cell
          marks[next] = FRONTIER
          queue[tail] = next
          tail = tail + 1
        }
        index = index + 1
      }
    }
    ring = ring + 1
  }

  if cameFrom[EXIT] == NONE {
    run Effect.log("The mouse cannot reach the cheese.\n", &())
    return ()
  }

  // Walks back from the cheese, one step per frame.
  let mut steps = 0
  let mut cell = cameFrom[EXIT]
  while cell != START {
    marks[cell] = PATH
    steps = steps + 1
    run Effect.log("{}Walking back: {} steps\n\n", &(CLEAR, steps))
    run draw(&marks)
    run Effect.sleep(30ms)
    cell = cameFrom[cell]
  }
  run Effect.log(
    "{}The shortest way to the cheese takes {} steps. The search reached {} cells in {} rings.\n\n",
    &(CLEAR, steps + 1, tail, ring),
  )
  run draw(&marks)
}

pub effect fn main() -> ()
  ! LogError {
  let mut logger = StdoutLogger.make()
  let mut clock = OsMonotonicClock.make()
  run solve()
    |> Effect.provideMut(&mut logger)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}
