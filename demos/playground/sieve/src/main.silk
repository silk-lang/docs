//! The sieve of Eratosthenes: cross out the multiples of each prime, and the
//! numbers left standing are the primes.
import silk.core.effect { Effect }
import silk.text.format { Format }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }

const LIMIT: usize = 100

effect fn printPrimes() -> ()
  ! WriterError
  ? &mut Writer {
  let mut composite = [false; LIMIT]
  let mut number: usize = 2
  while number * number < LIMIT {
    if !composite[number] {
      let mut multiple = number * number
      while multiple < LIMIT {
        composite[multiple] = true
        multiple = multiple + number
      }
    }
    number = number + 1
  }

  run Format.format("The primes below {}:\n", &.(LIMIT))
  let mut count = 0
  let mut candidate: usize = 2
  while candidate < LIMIT {
    if !composite[candidate] {
      run Format.format("{:>3}", &.(candidate))
      count = count + 1
      if count % 10 == 0 {
        run Format.format("\n", &())
      }
    }
    candidate = candidate + 1
  }
  run Format.format("\n{} primes in all.\n", &.(count))
}

pub effect fn main() -> ()
  ! WriterError {
  let mut stdout = StdoutWriter.make()
  run printPrimes() |> Effect.provideMut<Writer>(&mut stdout)
}
