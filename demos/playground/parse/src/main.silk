//! Reading numbers from text. `Format.i32Value` answers a `Result`, so a
//! caller has to say what happens when the text is not a number before it can
//! use the value.
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.text.format { Format, NotANumber, OutOfRange, ParseError }

effect fn read(text: string) -> ()
  ! WriterError
  ? &mut Writer {
  match move Format.i32Value(text) {
    Result<i32, ParseError>.Success { value } => {
      run Format.format("{:>14?} -> {}, doubled {}\n", &(text, value, value * 2))
    }
    Result<i32, ParseError>.Failure { error } => match move error.reason {
      NotANumber { offset } => {
        run Format.format("{:>14?} -> not a number, at byte {}\n", &(text, offset))
      }
      OutOfRange {} => {
        run Format.format("{:>14?} -> does not fit in an i32\n", &.(text))
      }
    }
  }
}

effect fn readAll() -> ()
  ! WriterError
  ? &mut Writer {
  let inputs = ["42", "-17", "12x", "", "3000000000"]
  let mut index: usize = 0
  while index < inputs.length {
    run read(inputs[index])
    index = index + 1
  }
}

pub effect fn main() -> ()
  ! WriterError {
  let mut stdout = StdoutWriter.make()
  run readAll() |> Effect.provideMut<Writer>(&mut stdout)
}
