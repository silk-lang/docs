# Every page is cross-origin isolated, so the playground's language server can
# block on shared memory (src/playground/channel.ts). The site loads nothing
# from other origins. It is every page and not only /playground because the
# site navigates between pages without reloading, and isolation is set when a
# document loads.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Vite puts a content hash in every file name under /assets, so a cached copy
# never goes stale. Everything else keeps Cloudflare's default revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

# The docs for language models (scripts/llms-txt.ts).
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/llm.txt
  Content-Type: text/plain; charset=utf-8

/llm-full.txt
  Content-Type: text/plain; charset=utf-8
